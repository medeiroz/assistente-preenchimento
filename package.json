{
  "name": "assistente-preenchimento",
  "private": true,
  "version": "1.0.2",
  "description": "Extensão do Chrome que preenche campos de formulários automaticamente nos sites escolhidos, a partir de regras criadas pelo próprio usuário.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medeiroz/assistente-preenchimento.git"
  },
  "homepage": "https://github.com/medeiroz/assistente-preenchimento",
  "bugs": {
    "url": "https://github.com/medeiroz/assistente-preenchimento/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build:e2e": "wxt build --mode e2e",
    "e2e": "npm run build:e2e && playwright test",
    "harness": "node tests/e2e/harness-server.ts",
    "postinstall": "wxt prepare",
    "zip": "wxt zip",
    "icons": "node scripts/generate-icons.mjs",
    "screenshots": "npm run build:e2e && node scripts/generate-screenshots.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@wxt-dev/module-vue": "^1.0.3",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "vue-multiselect-v2": "npm:vue-multiselect@2.1.9",
    "vue-tsc": "^3.3.14",
    "vue2": "npm:vue@2.7.16",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "vue": "^3.5.45",
    "zod": "^4.6.7"
  }
}
